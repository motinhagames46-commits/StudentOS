// Modelo de dados — secção 10 da especificação.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum AssessmentType {
  TEST
  EXAM
  PROJECT
  ASSIGNMENT
  PRESENTATION
  OTHER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  DONE
}

// Origem dos dados (spec §6.1): distingue o que foi criado à mão do que foi importado.
enum DataOrigin {
  MANUAL
  IMPORT_ICS
  IMPORT_CSV
}

enum BlockKind {
  CLASS
  EVENT
  OTHER
}

enum PlannedSessionStatus {
  PLANNED
  COMPLETED
  MISSED
  CANCELLED
}

enum StudyPlanStatus {
  DRAFT
  CONFIRMED
  SUPERSEDED
  DISCARDED
}

// IA, documentos, estudo com repetição espaçada e finanças (passo 1 do roteiro com o Gemini)
enum DocumentSource {
  SCAN
  PDF
  TEXT
}

enum DocumentStatus {
  PROCESSING
  READY
  FAILED
}

enum CardKind {
  MCQ
  SHORT
}

enum FinanceKind {
  EXPENSE
  INCOME
}

enum ImportKind {
  ICS
  CSV
}

enum ImportStatus {
  NEEDS_REVIEW
  CONFIRMED
  FAILED
  EXPIRED
}

model User {
  id                Int                  @id @default(autoincrement())
  name              String
  email             String               @unique
  passwordHash      String
  tokenVersion      Int                  @default(0) // legado (JWT); mantido para permitir rollback
  termsAcceptedAt   DateTime? // aceitação dos Termos de utilização no registo (contas anteriores: null)
  termsVersion      String?
  aiConsentAt       DateTime? // consentimento para enviar dados ao Gemini (só contas da lista AI_ALLOWED_EMAILS)
  aiConsentVersion  String?
  lastLoginAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  sessions          UserSession[]
  scheduleBlocks    ScheduleBlock[]
  importJobs        ImportJob[]
  semesters         Semester[]
  disciplines       Discipline[]
  tasks             Task[]
  studySessions     StudySession[]
  studyPreferences  StudyPreferences?
  availabilityRules AvailabilityRule[]
  studyPlans        StudyPlan[]
  plannedSessions   PlannedSession[]
  transfersSent     DisciplineTransfer[]
  studyDocuments    StudyDocument[]
  documentChunks    DocumentChunk[]
  studyCards        StudyCard[]
  cardReviews       CardReview[]
  quizzes           Quiz[]
  financeCategories FinanceCategory[]
  transactions      FinanceTransaction[]
  savingsGoals      SavingsGoal[]
  financeInsights   FinanceInsight[]
}

// Sessão de autenticação no servidor (spec §14.1). O cookie leva um token opaco aleatório;
// a base de dados guarda apenas o SHA-256 desse token.
model UserSession {
  id         Int      @id @default(autoincrement())
  tokenHash  String   @unique
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Semester {
  id          Int          @id @default(autoincrement())
  label       String
  startDate   DateTime     @db.Date
  endDate     DateTime     @db.Date
  isActive    Boolean      @default(false)
  userId      Int
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  disciplines Discipline[]

  @@index([userId])
}

model Discipline {
  id              Int              @id @default(autoincrement())
  name            String
  code            String
  ects            Int?
  passingGrade    Float            @default(10)
  color           String?
  absences        Int              @default(0) // faltas registadas pelo estudante (na unidade que ele escolher)
  absenceLimit    Int? // limite de faltas do regulamento da UC; sem limite, não há aviso
  archivedAt      DateTime? // arquivada: fora das listas ativas, histórico preservado
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userId          Int
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  semesterId      Int?
  semester        Semester?        @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  assessments     Assessment[]
  tasks           Task[]
  studySessions   StudySession[]
  scheduleBlocks  ScheduleBlock[]
  plannedSessions PlannedSession[]
  studyDocuments  StudyDocument[]
  studyCards      StudyCard[]
  quizzes         Quiz[]

  @@unique([userId, semesterId, code])
  @@index([userId])
}

model Assessment {
  id              Int              @id @default(autoincrement())
  name            String
  type            AssessmentType   @default(TEST)
  weight          Float
  date            DateTime?
  score           Float?
  minScore        Float?
  prepMinutes     Int? // tempo estimado de preparação (planeador)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  disciplineId    Int
  discipline      Discipline       @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  plannedSessions PlannedSession[]

  @@index([disciplineId])
}

model Task {
  id               Int              @id @default(autoincrement())
  title            String
  description      String?
  dueDate          DateTime?
  priority         TaskPriority     @default(MEDIUM)
  status           TaskStatus       @default(TODO)
  completedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  userId           Int
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  disciplineId     Int?
  discipline       Discipline?      @relation(fields: [disciplineId], references: [id], onDelete: SetNull)
  origin           DataOrigin       @default(MANUAL)
  externalId       String?
  importJobId      String?
  importJob        ImportJob?       @relation(fields: [importJobId], references: [id], onDelete: SetNull)
  estimatedMinutes Int? // duração estimada (planeador)
  plannedSessions  PlannedSession[]

  @@unique([userId, origin, externalId])
  @@index([userId, status, dueDate])
}

model StudySession {
  id               Int             @id @default(autoincrement())
  startedAt        DateTime
  endedAt          DateTime?
  notes            String?
  targetMinutes    Int? // preset de foco (ex.: 25 ou 50)
  breakMinutes     Int? // pausa sugerida no fim (ex.: 5 ou 10)
  pausedAt         DateTime? // pausa em curso
  pausedSeconds    Int             @default(0) // tempo total em pausa (não conta como estudo)
  userId           Int
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  disciplineId     Int?
  discipline       Discipline?     @relation(fields: [disciplineId], references: [id], onDelete: SetNull)
  plannedSessionId Int?
  plannedSession   PlannedSession? @relation(fields: [plannedSessionId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
}

// Aula ou evento (spec §6.1 ScheduleBlock). Séries recorrentes guardam a regra (RRULE) e as
// exceções; as ocorrências são geradas apenas no intervalo pedido, em hora local de `timezone`.
model ScheduleBlock {
  id             Int         @id @default(autoincrement())
  title          String
  kind           BlockKind   @default(CLASS)
  location       String?
  description    String?
  startAt        DateTime // início da primeira ocorrência
  endAt          DateTime
  allDay         Boolean     @default(false)
  timezone       String      @default("Europe/Lisbon")
  isBusy         Boolean     @default(true)
  recurrenceRule String? // ex.: FREQ=WEEKLY;BYDAY=MO;UNTIL=20270131T235959Z
  exceptionDates DateTime[] // inícios de ocorrências canceladas (EXDATE)
  seriesEndAt    DateTime? // fim da última ocorrência; null = série sem fim
  origin         DataOrigin  @default(MANUAL)
  externalId     String? // UID do iCalendar (+ RECURRENCE-ID)
  fingerprint    String // hash determinístico para deteção de duplicados
  sourceLabel    String? // ex.: "horario.ics"
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  userId         Int
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  disciplineId   Int?
  discipline     Discipline? @relation(fields: [disciplineId], references: [id], onDelete: SetNull)
  importJobId    String?
  importJob      ImportJob?  @relation(fields: [importJobId], references: [id], onDelete: SetNull)

  @@unique([userId, origin, externalId])
  @@index([userId, startAt])
  @@index([userId, fingerprint])
}

// Importação em curso ou concluída (spec §6.1 ImportJob). O ficheiro original nunca é guardado:
// só os itens normalizados, até à confirmação ou à expiração (24 h).
model ImportJob {
  id               String          @id @default(uuid())
  kind             ImportKind
  status           ImportStatus    @default(NEEDS_REVIEW)
  originalFilename String
  items            Json
  options          Json?
  warnings         Json?
  counts           Json?
  createdAt        DateTime        @default(now())
  expiresAt        DateTime
  confirmedAt      DateTime?
  userId           Int
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduleBlocks   ScheduleBlock[]
  tasks            Task[]

  @@index([userId, createdAt])
}

// Preferências de estudo (spec §6.1 PlanningPreference). Valores por omissão documentados em docs/ARCHITECTURE.md.
model StudyPreferences {
  id                Int      @id @default(autoincrement())
  sessionMinutes    Int      @default(50)
  minSessionMinutes Int      @default(25)
  breakMinutes      Int      @default(10)
  maxDailyMinutes   Int      @default(180)
  updatedAt         DateTime @updatedAt
  userId            Int      @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Janela semanal disponível para estudo (spec §6.1 AvailabilityRule), em hora local.
model AvailabilityRule {
  id          Int      @id @default(autoincrement())
  weekday     Int // 1 = segunda … 7 = domingo
  startMinute Int // minutos desde a meia-noite
  endMinute   Int
  createdAt   DateTime @default(now())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Versão de um plano (spec §6.1 StudyPlan). Um rascunho guarda a proposta até ser confirmado.
model StudyPlan {
  id          String           @id @default(uuid())
  version     Int
  status      StudyPlanStatus  @default(DRAFT)
  fromDate    DateTime
  toDate      DateTime
  proposal    Json
  rules       Json
  createdAt   DateTime         @default(now())
  confirmedAt DateTime?
  userId      Int
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions    PlannedSession[]

  @@index([userId, createdAt])
}

// Sessão de estudo planeada (spec §6.1 StudySession). Distinta de StudySession, que regista o foco real.
model PlannedSession {
  id             Int                  @id @default(autoincrement())
  startAt        DateTime
  endAt          DateTime
  plannedMinutes Int
  actualMinutes  Int?
  status         PlannedSessionStatus @default(PLANNED)
  pinned         Boolean              @default(false)
  reason         String
  /// Sessão para as revisões devidas (repetição espaçada), sem tarefa nem avaliação.
  isReview       Boolean              @default(false)
  completedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  userId         Int
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId         Int?
  task           Task?                @relation(fields: [taskId], references: [id], onDelete: SetNull)
  assessmentId   Int?
  assessment     Assessment?          @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  disciplineId   Int?
  discipline     Discipline?          @relation(fields: [disciplineId], references: [id], onDelete: SetNull)
  planId         String?
  plan           StudyPlan?           @relation(fields: [planId], references: [id], onDelete: SetNull)
  focusSessions  StudySession[]

  @@index([userId, startAt])
}

// Transferência de disciplinas entre contas do mesmo estudante: a conta de origem gera um código de uso
// único (só o SHA-256 fica guardado), que é aceite com sessão iniciada na conta de destino.
model DisciplineTransfer {
  id                    Int       @id @default(autoincrement())
  codeHash              String    @unique
  disciplineIds         Int[]
  includeUnlinkedBlocks Boolean   @default(false) // aulas do horário sem disciplina associada
  expiresAt             DateTime
  usedAt                DateTime?
  toUserId              Int? // conta que aceitou (sem relação: a conta de destino pode ser eliminada)
  createdAt             DateTime  @default(now())
  fromUserId            Int
  fromUser              User      @relation(fields: [fromUserId], references: [id], onDelete: Cascade)

  @@index([fromUserId])
}

// Documento digitalizado ou carregado. Só se guarda o texto extraído (as imagens não ficam guardadas).
model StudyDocument {
  id           Int             @id @default(autoincrement())
  title        String
  source       DocumentSource
  status       DocumentStatus  @default(PROCESSING)
  pageCount    Int             @default(0)
  text         String          @default("")
  /// Datas propostas pela IA à espera de revisão; esvazia-se ao confirmar (minimização de dados).
  proposals    Json            @default("[]")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  userId       Int
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  disciplineId Int?
  discipline   Discipline?     @relation(fields: [disciplineId], references: [id], onDelete: SetNull)
  chunks       DocumentChunk[]
  cards        StudyCard[]
  quizzes      Quiz[]

  @@index([userId, createdAt])
}

// Excerto de um documento com o seu vetor (normalizado). Busca exata em SQL: para uma pessoa chega;
// passa a pgvector + HNSW se o volume crescer (docs/ARCHITECTURE.md).
model DocumentChunk {
  id             Int           @id @default(autoincrement())
  ordinal        Int
  content        String
  embedding      Float[]
  embeddingModel String
  documentId     Int
  document       StudyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId         Int
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, ordinal])
  @@index([userId])
}

// Pergunta de revisão com o estado FSRS (ts-fsrs): state 0 nova, 1 a aprender, 2 revisão, 3 a reaprender.
model StudyCard {
  id             Int            @id @default(autoincrement())
  kind           CardKind
  question       String
  options        String[]
  correctOption  Int?
  expectedAnswer String?
  explanation    String?
  due            DateTime       @default(now())
  stability      Float          @default(0)
  difficulty     Float          @default(0)
  elapsedDays    Int            @default(0)
  scheduledDays  Int            @default(0)
  learningSteps  Int            @default(0)
  reps           Int            @default(0)
  lapses         Int            @default(0)
  state          Int            @default(0)
  lastReview     DateTime?
  createdAt      DateTime       @default(now())
  userId         Int
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  disciplineId   Int?
  discipline     Discipline?    @relation(fields: [disciplineId], references: [id], onDelete: SetNull)
  documentId     Int?
  document       StudyDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  quizId         Int?
  quiz           Quiz?          @relation(fields: [quizId], references: [id], onDelete: SetNull)
  reviews        CardReview[]

  @@index([userId, due])
}

model CardReview {
  id            Int       @id @default(autoincrement())
  rating        Int // 1 de novo, 2 difícil, 3 bem, 4 fácil
  state         Int
  due           DateTime
  stability     Float
  difficulty    Float
  elapsedDays   Int
  scheduledDays Int
  reviewedAt    DateTime  @default(now())
  cardId        Int
  card          StudyCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId        Int
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([userId, reviewedAt])
}

// Quiz gerado no fim de uma sessão: perguntas em JSON validado com Zod, resultado depois de respondido.
model Quiz {
  id           Int            @id @default(autoincrement())
  topic        String
  questions    Json
  score        Float?
  answeredAt   DateTime?
  createdAt    DateTime       @default(now())
  userId       Int
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  disciplineId Int?
  discipline   Discipline?    @relation(fields: [disciplineId], references: [id], onDelete: SetNull)
  documentId   Int?
  document     StudyDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  cards        StudyCard[]

  @@index([userId, createdAt])
}

model FinanceCategory {
  id           Int                  @id @default(autoincrement())
  name         String
  kind         FinanceKind
  color        String?
  userId       Int
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions FinanceTransaction[]

  @@unique([userId, kind, name])
}

// Dinheiro sempre em cêntimos inteiros (EUR), para não haver erros de arredondamento.
model FinanceTransaction {
  id          Int              @id @default(autoincrement())
  kind        FinanceKind
  amountCents Int
  occurredOn  DateTime         @db.Date
  note        String?
  createdAt   DateTime         @default(now())
  userId      Int
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  Int?
  category    FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, occurredOn])
}

model SavingsGoal {
  id          Int       @id @default(autoincrement())
  name        String
  targetCents Int
  savedCents  Int       @default(0)
  deadline    DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Dicas de poupança da IA e o resumo agregado em que se basearam (sem descrições nem datas exatas).
model FinanceInsight {
  id        Int      @id @default(autoincrement())
  tips      Json
  basedOn   Json
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
